diff --git a/amb96/assets_types.h b/amb96/assets_types.h
new file mode 100644
index 0000000..d4d1f78
--- /dev/null
+++ b/amb96/assets_types.h
@@ -0,0 +1,45 @@
+#ifndef ASSETS_TYPES_H
+#define ASSETS_TYPES_H
+
+#include <stdint.h>
+
+/* =========================================================================
+   Types des données graphiques, telles que les produit tools/bmp2c.
+
+   Tous les pixels sont des index de palette sur 8 bits (mode Packed Pixel
+   du VDP 32X). L'index 0 est transparent pour les sprites.
+   ========================================================================= */
+
+/* Les tiles sont carrées, de 32 x 32 pixels (comme dans AMB96 d'origine) */
+#define TILE_SHIFT 5
+#define TILE_SIZE (1 << TILE_SHIFT)
+#define TILE_PIXELS (TILE_SIZE * TILE_SIZE)
+
+/* Jeu de tiles partagé par les plans : 'count' tiles de TILE_PIXELS
+   octets, rangées ligne par ligne. Au plus 256 tiles (index sur un octet). */
+typedef struct {
+  uint16_t count;
+  const uint8_t *pixels;
+} Tileset;
+
+/* Plan : grille de widthTiles x heightTiles numéros de tile, ligne par
+   ligne. Les deux dimensions sont des puissances de 2, pour que le
+   défilement boucle avec un simple masque. */
+typedef struct {
+  uint16_t widthTiles;
+  uint16_t heightTiles;
+  const uint8_t *cells;
+} Tilemap;
+
+/* Sprite : width x height pixels, ligne par ligne */
+typedef struct {
+  uint16_t width;
+  uint16_t height;
+  const uint8_t *pixels;
+} Sprite;
+
+/* Palette : 256 couleurs au format du VDP 32X, 0bbbbbgggggrrrrr
+   (le bit 15, priorité, est laissé à 0). */
+#define PALETTE_COLORS 256
+
+#endif
diff --git a/amb96/framebuffer.c b/amb96/framebuffer.c
new file mode 100644
index 0000000..9566221
--- /dev/null
+++ b/amb96/framebuffer.c
@@ -0,0 +1,6 @@
+#include "framebuffer.h"
+
+void fb_init_line_table(int screenHeight) {
+  for (int y = 0; y < screenHeight; y++)
+    vdp_dram[y] = (uint16_t)((FB_LINE_TABLE_BYTES + y * FB_WIDTH) / 2);
+}
diff --git a/amb96/framebuffer.h b/amb96/framebuffer.h
new file mode 100644
index 0000000..1d64f6f
--- /dev/null
+++ b/amb96/framebuffer.h
@@ -0,0 +1,42 @@
+#ifndef FRAMEBUFFER_H
+#define FRAMEBUFFER_H
+
+#include <stdint.h>
+
+#include "vdp.h"
+
+/* =========================================================================
+   Frame buffer du VDP 32X en mode Packed Pixel (un octet par pixel).
+
+   La DRAM commence par la table de lignes : un mot par ligne affichée,
+   qui donne l'adresse (en mots) des pixels de la ligne. On réserve
+   256 mots (512 octets), comme AMB96 d'origine, puis les lignes se
+   suivent, de FB_WIDTH octets chacune.
+   ========================================================================= */
+
+#define FB_WIDTH VDP_SCREEN_WIDTH
+#define FB_LINE_TABLE_BYTES 512
+
+/* Remplit la table de lignes du frame buffer de dessin */
+void fb_init_line_table(int screenHeight);
+
+/* Premier pixel de la ligne 0 du frame buffer de dessin.
+   vdp_dram change à chaque échange de frame buffer : appeler cette
+   fonction au début de chaque image, une fois l'échange effectué. */
+static inline uint8_t *fb_pixels(void) {
+  return (uint8_t *)vdp_dram + FB_LINE_TABLE_BYTES;
+}
+
+/* Ce qu'un CPU dessine pendant une image : les lignes firstLine,
+   firstLine + lineStep, firstLine + 2 * lineStep...
+   Avec deux CPU : lineStep = 2, firstLine = 0 (Master) ou 1 (Slave).
+   Chaque CPU possède entièrement ses lignes (fond puis sprites) : aucun
+   des deux n'a besoin d'attendre l'autre au milieu de l'image. */
+typedef struct {
+  uint8_t *pixels; /* ligne 0 */
+  int height;
+  int firstLine;
+  int lineStep;
+} Screen;
+
+#endif
diff --git a/amb96/md68k.c b/amb96/md68k.c
new file mode 100644
index 0000000..a7b328d
--- /dev/null
+++ b/amb96/md68k.c
@@ -0,0 +1,18 @@
+/* =========================================================================
+   Programme 68000 (Mega Drive).
+
+   Il ne fait plus qu'une chose : à chaque VBlank, lire la manette et la
+   transmettre aux SH2 par un registre COMM. Toute la logique du jeu est
+   sur le Master SH2.
+   (Dans AMB96.asm, le 68000 calculait aussi les défilements.)
+
+   Sur la console, ce serait du code 68000 : lecture du port $A10003
+   (TH haut puis TH bas), puis écriture en $A15120 + 2 * COMM_PAD.
+   ========================================================================= */
+
+#include "game.h"
+#include "interface.h"
+#include "platform.h"
+#include "shared.h"
+
+void md_vint(void) { comm[COMM_PAD] = (uint16_t)platform_read_pad(); }
diff --git a/amb96/plane.c b/amb96/plane.c
new file mode 100644
index 0000000..f96c1ef
--- /dev/null
+++ b/amb96/plane.c
@@ -0,0 +1,43 @@
+#include "plane.h"
+#include "framebuffer.h"
+
+#include <string.h>
+
+/* La ligne est construite morceau par morceau : la fin de la première
+   tile (à partir de la colonne scrollX), les tiles entières, puis le
+   début de la dernière. Les dimensions du plan étant des puissances de 2,
+   le bouclage n'est qu'un masque.
+
+   Sur SH2, memcpy est la première chose à optimiser (copies par mots
+   longs quand source et destination sont alignées, comme les routines
+   drawTileLine* de la version assembleur). */
+void plane_draw_line(uint8_t *dst, const Tilemap *map, const Tileset *tiles,
+                     int scrollX, int worldY) {
+  const int widthMask = (map->widthTiles << TILE_SHIFT) - 1;
+  const int heightMask = (map->heightTiles << TILE_SHIFT) - 1;
+
+  worldY &= heightMask;
+
+  /* Rangée de tiles traversée par la ligne, et ligne dans chaque tile */
+  const uint8_t *row = map->cells + (worldY >> TILE_SHIFT) * map->widthTiles;
+  const uint8_t *tileLine =
+      tiles->pixels + (worldY & (TILE_SIZE - 1)) * TILE_SIZE;
+
+  int x = scrollX & widthMask;
+  int remaining = FB_WIDTH;
+
+  while (remaining > 0) {
+    int xInTile = x & (TILE_SIZE - 1);
+    int count = TILE_SIZE - xInTile;
+    if (count > remaining)
+      count = remaining;
+
+    const uint8_t *src =
+        tileLine + row[x >> TILE_SHIFT] * TILE_PIXELS + xInTile;
+    memcpy(dst, src, (size_t)count);
+
+    dst += count;
+    remaining -= count;
+    x = (x + count) & widthMask;
+  }
+}
